DATABASE_URL=sqlite:///./data/opd.db
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LOCAL_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
# Free alternative: AI_PROVIDER=groq. Keys stay in the backend-only .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Packaged deployment only; local development can leave these defaults.
PUBLIC_BASE_URL=
COOKIE_SECURE=false
SEED_DEMO_ON_EMPTY=false
PORT=8000
